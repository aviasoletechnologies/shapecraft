{
  "name": "@aviasole/shapecraft",
  "version": "3.0.0",
  "description": "Structured output generation for LLMs in Node.js — token-level constraints for local models, native JSON modes for cloud APIs",
  "author": "Aviasole Technologies",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/aviasoletechnologies/shapecraft.git"
  },
  "homepage": "https://aviasoletechnologies.github.io/shapecraft/",
  "bugs": {
    "url": "https://github.com/aviasoletechnologies/shapecraft/issues"
  },
  "keywords": [
    "llm",
    "structured-output",
    "constrained-generation",
    "json-schema",
    "zod",
    "openai",
    "ollama",
    "llama",
    "ai"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "shapecraft": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fhir": {
      "types": "./dist/fhir/index.d.ts",
      "import": "./dist/fhir/index.js",
      "require": "./dist/fhir/index.cjs"
    },
    "./agentic": {
      "types": "./dist/agentic/index.d.ts",
      "import": "./dist/agentic/index.js",
      "require": "./dist/agentic/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck && npm run test",
    "docs:dev": "npm --prefix docs run docs:dev",
    "docs:build": "npm --prefix docs run docs:build",
    "docs:preview": "npm --prefix docs run docs:preview"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.107.0",
    "@google/genai": "^1.52.0",
    "@types/node": "^20.0.0",
    "groq-sdk": "^1.3.0",
    "openai": "^6.45.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.20.0",
    "@google/genai": ">=1.0.0",
    "groq-sdk": ">=0.5.0",
    "node-llama-cpp": ">=3.0.0",
    "ollama": ">=0.5.0",
    "openai": ">=4.0.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "node-llama-cpp": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "ollama": {
      "optional": true
    },
    "groq-sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@readme/openapi-parser": "^6.3.0",
    "fast-xml-parser": "^5.9.3",
    "yaml": "^2.9.0",
    "zod-to-json-schema": "^3.23.0"
  }
}
